{
  "llm": {
    "base_url": "https://api.openai.com/v1",
    "api_key": "env:OPENAI_API_KEY",
    "model_name": "gpt-5.6-luna",
    "reasoning_effort": "max"
  },
  "tts": {
    "mode": "external",
    "url": "http://127.0.0.1:18000/tts",
    "urls": [
      "http://127.0.0.1:18000/tts",
      "http://127.0.0.1:18001/tts"
    ],
    "external_timeout": 300,
    "external_max_chars": 2000,
    "external_batch_size": 48,
    "device": "auto",
    "language": "Chinese",
    "parallel_workers": 2,
    "compile_codec": false,
    "sub_batch_enabled": true,
    "sub_batch_min_size": 4,
    "sub_batch_ratio": 5.0,
    "sub_batch_max_items": 0,
    "pause_between_speakers_ms": 500,
    "pause_same_speaker_ms": 250,
    "voice_profile_urls": [
      "http://127.0.0.1:18000/voice_profiles/design",
      "http://127.0.0.1:18001/voice_profiles/design"
    ],
    "voice_profile_timeout": 900,
    "voice_profile_required": true
  },
  "sfx": {
    "enabled": true,
    "manifest": "assets/sfx/manifest.json",
    "max_effects_per_chapter": 80,
    "provider": "builtin",
    "auto_generate_missing": true,
    "url": "http://127.0.0.1:18100/sfx",
    "cache_dir": "cache/sfx",
    "fallback_to_manifest": true,
    "timeout": 300,
    "seed": 0,
    "steps": 25,
    "guidance_scale": 5.0,
    "sway_sampling_coef": -1.0
  },
  "audio": {
    "mix_sample_rate": 48000,
    "mix_channels": 1,
    "mix_sample_format": "pcm_s16le",
    "publish_sample_rate": 44100,
    "publish_channels": 1,
    "publish_codec": "aac",
    "publish_profile": "aac_low",
    "publish_bitrate": "96k",
    "faststart": true
  },
  "generation": {
    "chunk_size": 3000,
    "max_tokens": 4096,
    "temperature": 0.6,
    "top_p": 0.8,
    "top_k": 0,
    "min_p": 0,
    "presence_penalty": 0.0,
    "banned_tokens": [],
    "merge_narrators": false
  }
}
